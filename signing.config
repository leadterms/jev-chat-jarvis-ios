# =============================================================================
#  Jev Jarvis —— 签名配置（单一配置源）
# -----------------------------------------------------------------------------
#  换证书 / 描述文件时，只改这个文件，然后运行：
#
#      python tools/apply-signing.py           # 把下面的值写进工程
#      python tools/apply-signing.py --dry-run # 只预览会改什么，不写文件
#
#  脚本会自动写入这些文件，不需要手动改：
#      - project.yml                              （xcodegen 工程定义）
#      - JevJarvis.xcodeproj/project.pbxproj      （Bundle ID / Team / 签名方式）
#      - App/JevJarvis.entitlements               （App Group）
#      - Keyboard/JevKeyboard.entitlements        （App Group）
#      - Shared/JevModel.swift                    （App Group 常量）
#      - .github/workflows/build-unsigned-ipa.yml （编译用，自动生成）
#
#  之后推送到 GitHub，Actions 会自动编出未签名 IPA：
#      git add -A && git commit -m "apply signing" && git push
#  （或直接 `python tools/apply-signing.py --push` 一步完成套用+推送）
#
#  规则：值为空 = 不修改该字段（留着工程原样）。
# =============================================================================

# 主 App 的 Bundle ID。必须与描述文件的 application-identifier 一致。
MAIN_BUNDLE_ID=com.jevchat.jarvis

# 键盘扩展的 Bundle ID = 主 Bundle ID + 这个后缀。
KEYBOARD_BUNDLE_ID_SUFFIX=.keyboard

# 开发者 Team ID（描述文件里的 TeamIdentifier，10 位字母数字）。
TEAM_ID=75LZ93U5CF

# App Group：App 与键盘共享配置的容器，必须与描述文件里的一致。
APP_GROUP_ID=group.com.jevchat.jarvis

# 签名方式：填 Manual = 手动签名；留空 = 不修改（工程保持 Automatic）。
CODE_SIGN_STYLE=

# 签名证书名。手动签名时通常填：Apple Distribution（ad-hoc 可用 iPhone Distribution）。
# 留空 = 不修改。
CODE_SIGN_IDENTITY=

# 描述文件名字（是 .mobileprovision 里的 Name，不是文件名）。
# 主 App 与键盘扩展各要一个；PROFILE_NAME_KEYBOARD 留空则复用 PROFILE_NAME。
# 留空 = 不修改。
PROFILE_NAME=
PROFILE_NAME_KEYBOARD=

# 版本号。上传 App Store 时 CURRENT_PROJECT_VERSION 每次必须递增。
MARKETING_VERSION=0.1.0
CURRENT_PROJECT_VERSION=1
